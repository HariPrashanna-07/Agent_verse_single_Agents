# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Encryption
MONGO_URI=mongodb://127.0.0.1:27017/ai_email_agent
JWT_SECRET=super_secret_jwt_key_ai_email_agent_2026
ENCRYPTION_KEY=default_secret_key_32_bytes_long_!

# Mode Configuration (Set DEMO_MODE=false when using live Google & Groq keys)
DEMO_MODE=true

# Groq AI Provider Credentials (Get from https://console.groq.com/)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Google OAuth 2.0 Credentials (Get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
