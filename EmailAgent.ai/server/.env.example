# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Encryption
MONGO_URI=mongodb://127.0.0.1:27017/ai_email_agent
JWT_SECRET=super_secret_jwt_key_ai_email_agent_2026
ENCRYPTION_KEY=default_secret_key_32_bytes_long_!

# Mode Configuration (Set DEMO_MODE=false when using live Google & Gemini keys)
DEMO_MODE=true

# Google Gemini API Credentials (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Google OAuth 2.0 Credentials (Get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
