# SpendWise AI Environment Configuration

# Provider choice: "openai", "groq", "openrouter", or "gemini"
LLM_PROVIDER=groq

# API Key (Set one of these depending on provider)
GROQ_API_KEY=your_groq_api_key_here

# Model Selection
# Default for OpenAI: gpt-4o-mini or gpt-4o
LLM_MODEL=llama-3.3-70b-versatile

# Database URL
DATABASE_URL=sqlite:///./spendwise.db

# Currency Symbol
CURRENCY_SYMBOL=₹
